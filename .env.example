# Copy to .env and fill in from Supabase dashboard → Project Settings → API.
# EXPO_PUBLIC_ vars are embedded in the client bundle — anon key only, NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In client IDs (see docs/setup-social-sign-in.md).
# Neither is a secret: both are visible in any OAuth redirect and are restricted by bundle id.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
