{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Expose jest globals (describe/it/expect) to the typechecker in test files.
    "types": ["jest"],
    // "@/..." resolves to src/ — prefer aliases over deep relative imports.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Edge Functions run on Deno, not in the RN bundle — excluded from app typechecking.
  "exclude": ["node_modules", "supabase/functions"]
}
